{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "config:recommended"
    ],
    "customManagers": [
        {
            "customType": "regex",
            "description": "Update netlify-cli version in GitHub Actions workflows",
            "managerFilePatterns": [
                "/^\\.github/workflows/.*\\.ya?ml$/"
            ],
            "matchStrings": [
                "netlify-cli@(?<currentValue>\\d+(\\.\\d+)*(-[a-zA-Z0-9.]+)?)"
            ],
            "depNameTemplate": "netlify-cli",
            "datasourceTemplate": "npm",
            "versioningTemplate": "npm"
        },
        {
            "customType": "regex",
            "description": "Update explicitly Renovate-annotated tool and runtime versions.",
            "managerFilePatterns": [
                "/\\.(?:ya?ml|json|toml|ini|cfg|conf|properties|env|sh|bash|zsh)$/",
                "/(^|/)(?:Dockerfile|Containerfile)(?:\\.[^/]+)?$/",
                "/(^|/)Makefile$/",
                "/(^|/)(?:Jenkinsfile|Tiltfile|Taskfile(?:\\.ya?ml)?)$/",
                "/(^|/)(?:\\.gitlab-ci\\.ya?ml|\\.woodpecker\\.ya?ml|\\.drone\\.ya?ml)$/",
                "/(^|/)(?:concourse|forgejo|github|gitlab)(?:[-_.][^/]+)?(?:\\.ya?ml|\\.json|\\.toml)$/"
            ],
            "matchStrings": [
                "# renovate: datasource=(?<datasource>[^\\s]+) depName=(?<depName>[^\\s]+)(?: versioning=(?<versioning>[^\\s]+))?\\s*\\r?\\n\\s*default:\\s*[\"']?(?<currentValue>v?\\d+(?:\\.\\d+){0,3}(?:[-+][0-9A-Za-z._-]+)?)[\"']?",
                "# renovate: datasource=(?<datasource>[^\\s]+) depName=(?<depName>[^\\s]+)(?: versioning=(?<versioning>[^\\s]+))?\\s*\\r?\\n\\s*[A-Za-z][A-Za-z0-9_.-]*:\\s*[\"']?(?<currentValue>v?\\d+(?:\\.\\d+){0,3}(?:[-+][0-9A-Za-z._-]+)?)[\"']?",
                "# renovate: datasource=(?<datasource>[^\\s]+) depName=(?<depName>[^\\s]+)(?: versioning=(?<versioning>[^\\s]+))?\\s*\\r?\\n\\s*(?:ARG|ENV)\\s+[A-Za-z_][A-Za-z0-9_]*[=:][\"']?(?<currentValue>v?\\d+(?:\\.\\d+){0,3}(?:[-+][0-9A-Za-z._-]+)?)[\"']?",
                "# renovate: datasource=(?<datasource>[^\\s]+) depName=(?<depName>[^\\s]+)(?: versioning=(?<versioning>[^\\s]+))?\\s*\\r?\\n\\s*(?:export\\s+)?[A-Za-z_][A-Za-z0-9_]*=[\"']?(?<currentValue>v?\\d+(?:\\.\\d+){0,3}(?:[-+][0-9A-Za-z._-]+)?)[\"']?"
            ]
        }
    ],
    "gitlabci": {
        "managerFilePatterns": [
            "/(^|/)\\.gitlab-ci\\.ya?ml$/",
            "/^\\.gitlab/.*\\.ya?ml$/"
        ]
    },
    "gitlabci-include": {
        "managerFilePatterns": [
            "/(^|/)\\.gitlab-ci\\.ya?ml$/",
            "/^\\.gitlab/.*\\.ya?ml$/"
        ]
    },
    "packageRules": [
        {
            "matchUpdateTypes": [
                "minor",
                "patch"
            ],
            "automerge": true,
            "automergeType": "pr"
        },
        {
            "matchPackageNames": [
                "forgejo/upload-artifact",
                "forgejo/download-artifact"
            ],
            "enabled": false
        }
    ]
}