{
    "$schema": "https://docs.renovatebot.com/config-options/",
    "extends": [
        "config:recommended"
    ],
    "customManagers": [
        {
            "customType": "regex",
            "description": "Update netlify-cli version in GitHub Actions workflows",
            "managerFilePatterns": [
                "/^\\.github/workflows/.*\\.ya?ml$/"
            ],
            "matchStrings": [
                "netlify-cli@(?<currentValue>\\d+(\\.\\d+)*(-[a-zA-Z0-9.]+)?)"
            ],
            "depNameTemplate": "netlify-cli",
            "datasourceTemplate": "npm",
            "versioningTemplate": "npm"
        }
    ],
    "gitlabci": {
        "managerFilePatterns": [
            "/(^|/)\\.gitlab-ci\\.ya?ml$/",
            "/^\\.gitlab/.*\\.ya?ml$/"
        ]
    },
    "gitlabci-include": {
        "managerFilePatterns": [
            "/(^|/)\\.gitlab-ci\\.ya?ml$/",
            "/^\\.gitlab/.*\\.ya?ml$/"
        ]
    },
    "packageRules": [
        {
            "matchPackageNames": [
                "netlify-cli"
            ],
            "matchUpdateTypes": [
                "minor",
                "patch"
            ],
            "automerge": false
        },
        {
            "matchPackageNames": [
                "forgejo/upload-artifact",
                "forgejo/download-artifact"
            ],
            "enabled": false
        }
    ]
}